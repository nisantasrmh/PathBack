{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run Desktop Portal (Home.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/Home.py"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "📱 Run Mobile Portal (mobile_app.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/mobile_app.py",
                "--server.port",
                "8502"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "🔄 Retrain AI Model (train_model.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/pages/helper/train_model.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🐍 Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
