    "/api/match/run": {
      "post": {
        "tags": [
          "Biometrics"
        ],
        "summary": "Run Batch Match",
        "description": "Executes full database cross-matching comparing public sightings against active missing persons.\nRanked strictly by highest match confidence percentage.",
        "operationId": "run_batch_match_api_match_run_post",
        "parameters": [
          {
            "name": "similarity_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.1,
              "default": 0.363,
              "title": "Similarity Threshold"
            }
          },
          {
            "name": "high_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.5,
              "default": 0.75,
              "title": "High Threshold"
            }
          },
          {
            "name": "review_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.8,
              "minimum": 0.3,
              "default": 0.5,
              "title": "Review Threshold"
            }
          },
          {
            "name": "filter_user",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Filter User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
